
---
const { destaque } = Astro.props;
---

<div class:list={['cartao', { 'cartao-destaque': destaque }]}>
	<slot />
</div>

<style>
	.cartao {
		background: linear-gradient(
			145deg,
			#10233D 0%,
			#0B192D 100%
		);
		color: #C7DFF3;
		font-family: 'Poppins', system-ui, sans-serif;
		font-size: 0.92rem;
		border: 1px solid rgba(41, 197, 246, 0.18);
		border-radius: 16px;
		padding: 1.75rem;
		box-shadow: 0 8px 25px rgba(0, 0, 0, 0.18);
		transition: all 0.25s ease;
	}

	.cartao:hover {
		transform: translateY(-5px);
		border-color: rgba(41, 197, 246, 0.65);
		box-shadow: 0 12px 30px rgba(8, 124, 203, 0.16);
	}

	.cartao-destaque {
		background: linear-gradient(
			145deg,
			#12345A 0%,
			#0B192D 100%
		);
		border: 1px solid #087CCB;
		border-top: 3px solid #29C5F6;
	}

	.cartao-destaque:hover {
		border-color: #29C5F6;
	}
</style>
