---
import LayoutBase from '../layouts/LayoutBase.astro';
import Cartao from '../components/Cartao.astro';
import { empresa } from '../data/empresa.js';
---

<LayoutBase 
	titulo="Fale Conosco" 
	descricao={`Entre em contato com a ${empresa.nome}.`}
>
	<section class="secao">
		<div class="container">
			<div class="cabecalho-secao">
				<h1>Fale Conosco</h1>
				<p>Deseja construir uma solução de software sob medida para o seu negócio? Entre em contato com a {empresa.nome}!</p>
			</div>

			<div class="grid-contato">
				<Cartao>
					<h2>Nossa Sede</h2>
					<address>
						{empresa.contato.endereco.logradouro}, {empresa.contato.endereco.complemento}<br/>
						{empresa.contato.endereco.bairro}<br/>
						{empresa.contato.endereco.cidadeEstado}<br/>
						CEP: {empresa.contato.endereco.cep}
					</address>
				</Cartao>

				<Cartao>
					<h2>Canais Digitais</h2>
					<p><strong>E-mail:</strong> <a href={`mailto:${empresa.contato.email}`}>{empresa.contato.email}</a></p>
					<p><strong>Telefone:</strong> {empresa.contato.telefone}</p>
				</Cartao>
			</div>
		</div>
	</section>
</LayoutBase>

<style>
	.secao {
		color: #FFF8E7;
		font-family: 'Poppins', system-ui, sans-serif;
		font-size: 0.92rem;
		padding: 3.5rem 0;
		min-height: 60vh;
	}

	.cabecalho-secao {
		margin-bottom: 2.5rem;
		padding-left: 1rem;
		border-left: 3px solid #8CC1E9;
	}

	.cabecalho-secao h1 {
		font-family: 'Space Grotesk', system-ui, sans-serif;
		font-size: clamp(1.65rem, 3.2vw, 2.2rem);
		letter-spacing: -0.015em;
		text-transform: uppercase;
		color: #FFF8E7;
		margin-bottom: 0.65rem;
	}

	.cabecalho-secao p {
		font-size: 0.92rem;
		line-height: 1.65;
		color: #8CC1E9;
		font-weight: 400;
		max-width: 65ch;
	}

	.grid-contato {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
		gap: 1.75rem;
	}

	.grid-contato h2 {
		font-family: 'Space Grotesk', system-ui, sans-serif;
		font-size: 1.25rem;
		margin-bottom: 0.9rem;
		padding-bottom: 0.45rem;
		border-bottom: 1px solid #2B6CA3;
		color: #0E2A52;
	}

	address {
		font-style: normal;
		color: #091426;
		line-height: 1.75;
		font-size: 0.9rem;
	}

	.grid-contato p {
		color: #091426;
		font-size: 0.9rem;
		line-height: 1.65;
		margin-bottom: 0.6rem;
	}

	.grid-contato strong {
		color: #091426;
		font-weight: 700;
	}

	.grid-contato a {
		color: #0E2A52;
		font-weight: 600;
		text-decoration: none;
		border-bottom: 1px solid #2B6CA3;
		transition: color 0.2s ease, border-color 0.2s ease;
	}

	.grid-contato a:hover {
		color: #0b233b;
		border-bottom-color: #83bffa;
	}

	.grid-contato p:last-child {
		margin-bottom: 0;
	}
</style>