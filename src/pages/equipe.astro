---
import LayoutBase from '../layouts/LayoutBase.astro';
import Cartao from '../components/Cartao.astro';
import { empresa } from '../data/empresa.js';
---

<LayoutBase 
	titulo="Nossa Equipe" 
	descricao={`Conheça os profissionais por trás da ${empresa.nome}.`}
>
	<section class="secao secao-equipe">
		<div class="container">
			<div class="cabecalho-secao">
				<h1>Nossa Equipe Técnica</h1>
				<p>Conheça os profissionais que transformam requisitos de negócio em soluções de software seguras e escaláveis</p>
			</div>

			<div class="grid-equipe">
				{empresa.equipe.map((membro) => (
					<Cartao>
						<div class="card-membro-conteudo">
							<img 
								src={membro.foto} 
								alt={membro.alt} 
								class="foto-perfil" 
								width="140" 
								height="140" 
							/>
							<div class="info-membro">
								<h3>{membro.nome}</h3>
								<span class="cargo">{membro.cargo}</span>
								<p class="descricao-membro">{membro.descricao}</p>
							</div>
						</div>
					</Cartao>
				))}
			</div>
		</div>
	</section>
</LayoutBase>

<style>
	.secao-equipe {
		background-color: #E5E7EB;
		color: #091426;
		min-height: 100%;
	}

	.cabecalho-secao {
		margin-bottom: 2.5rem;
		padding-left: 1rem;
		border-left: 3px solid #0E2A52;
	}

	.cabecalho-secao h1 {
		font-family: 'Space Grotesk', system-ui, sans-serif;
		font-size: clamp(1.65rem, 3.2vw, 2.2rem);
		letter-spacing: -0.015em;
		text-transform: uppercase;
		color: #091426;
		margin-bottom: 0.65rem;
	}

	.cabecalho-secao p {
		font-family: 'Poppins', system-ui, sans-serif;
		font-size: 0.92rem;
		line-height: 1.65;
		color: #1F2937;
		font-weight: 400;
		max-width: 600px;
	}

	.grid-equipe {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
		gap: 1.75rem;
		max-width: 850px;
		margin: 0 auto;
	}

	.card-membro-conteudo {
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.foto-perfil {
		width: 132px;
		height: 132px;
		border-radius: 50%;
		object-fit: cover;
		margin-bottom: 1.15rem;
		border: 3px solid #2B6CA3;
		box-shadow: 0 6px 16px rgba(9, 20, 38, 0.16);
		transition: border-color 0.2s ease, transform 0.2s ease;
	}

	.foto-perfil:hover {
		border-color: #091426;
		transform: scale(1.03);
	}

	.info-membro h3 {
		font-family: 'Space Grotesk', system-ui, sans-serif;
		font-size: 1.1rem;
		color: #091426;
		margin-bottom: 0.35rem;
	}

	.cargo {
		display: inline-block;
		color: #FFF8E7;
		background: linear-gradient(90deg, #091426 0%, #0E2A52 100%);
		padding: 0.22rem 0.7rem;
		border-radius: 999px;
		border: 1px solid #2B6CA3;
		font-family: 'Poppins', system-ui, sans-serif;
		font-size: 0.72rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		margin-bottom: 0.9rem;
	}

	.descricao-membro {
		font-family: 'Poppins', system-ui, sans-serif;
		font-size: 0.88rem;
		line-height: 1.65;
		color: #091426;
		margin-bottom: 0;
	}
</style>